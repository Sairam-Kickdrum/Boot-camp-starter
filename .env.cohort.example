# ─── Boot Camp — Cohort Participant Environment ───────────────────────────────
#
# Fill in the Cognito values provided by your facilitator, then copy to .env:
#   cp .env.cohort.example .env
#
# Your Postgres DB runs locally in Docker — each participant has their own.
# You do NOT need AWS credentials; Cognito login uses the public USER_PASSWORD_AUTH flow.
# ─────────────────────────────────────────────────────────────────────────────

# Local database (Docker)
DATABASE_URL=postgresql://bootcamp:bootcamp@localhost:5432/bootcamp
DATABASE_URL_TEST=postgresql://bootcamp:bootcamp@localhost:5432/bootcamp_test

# API server
PORT=3000
NODE_ENV=development

# AWS region — must match the region where the shared pool was created
AWS_REGION=us-east-1

# Shared Cognito User Pool — values provided by your facilitator
COGNITO_USER_POOL_ID=<provided by facilitator>
COGNITO_CLIENT_ID=<provided by facilitator>

# AWS credentials — participants do NOT need these for auth.
# Only required if you start exercises that write to S3/SES (exercises 3 and 7).
# Leave blank until then.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LocalStack — only needed for exercises 3 (S3) and 7 (SES).
# Uncomment when you start those exercises:
# AWS_ENDPOINT_URL=http://localhost:4566

# Session cookie
SESSION_SECRET=change-me-in-production-this-is-only-for-local-dev

# Frontend
VITE_API_BASE_URL=/api
