# ─── Local dev environment (contributor / solo use) ───────────────────────────
#
# Two modes:
#   Local dev  — copy this file to .env, run scripts/seed-cognito.sh to create
#                the two example test users in your own Cognito User Pool.
#   Cohort     — use .env.cohort.example instead; credentials are provided by
#                your facilitator. Do NOT run seed-cognito.sh in cohort mode.
#
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://bootcamp:bootcamp@localhost:5432/bootcamp
DATABASE_URL_TEST=postgresql://bootcamp:bootcamp@localhost:5432/bootcamp_test

# API server
PORT=3000
NODE_ENV=development

# AWS — credentials required for local dev (seed-cognito.sh + CDK synth)
# Cohort participants leave these blank; auth uses the public Cognito endpoint.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito — fill in after creating the User Pool (docs/boot-camp/cognito-setup.md)
# Cohort participants: use the values provided by your facilitator.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# LocalStack endpoint — only needed for exercises 3 (S3) and 7 (SES)
# Uncomment when starting those exercises:
# AWS_ENDPOINT_URL=http://localhost:4566

# Session cookie (used by @fastify/cookie for cookie registration)
SESSION_SECRET=change-me-in-production-this-is-only-for-local-dev

# Frontend (Vite exposes VITE_* vars to the browser)
VITE_API_BASE_URL=/api
